# --- Required ---------------------------------------------------------------------------------
# A MongoDB database just for the Hub (not egertickets' or A-Read's).
MONGODB_URI=mongodb://127.0.0.1:27017/isa-tech-hub
# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Encrypts till credentials and webhook secrets in the database. Keep a copy somewhere safe:
# if it's lost or changed, re-enter every till's credentials with `npm run till -- set-credentials`.
HUB_SECRET_KEY=
# Public HTTPS address of this server. Safaricom posts payment results here, so it must be
# reachable from the internet and always on (not a host that sleeps when idle).
PUBLIC_URL=https://hub.example.com

# --- Optional ---------------------------------------------------------------------------------
PORT=5100
# Dashboard address(es) allowed to call the admin API, comma-separated. Not needed when the
# dashboard is served by this server (SERVE_CLIENT=true).
CLIENT_ORIGIN=http://localhost:5173
# SERVE_CLIENT=true
# Amount limits for one payment, in KES.
MIN_AMOUNT=1
MAX_AMOUNT=150000
# Background work (status sweep and webhook delivery). Leave on for the main server.
# WORKERS=false
# SWEEP_EVERY_MS=30000
# WEBHOOK_EVERY_MS=10000

# --- Only while running `npm run till -- add` / `set-credentials` -----------------------------
# Daraja app credentials (developer.safaricom.co.ke → My Apps) and the Lipa na M-Pesa Online
# passkey Safaricom emails at go-live. Remove them from this file afterwards: the Hub keeps its
# own encrypted copy in the database.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
