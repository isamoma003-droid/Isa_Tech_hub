# On Render these are set in the service's Environment tab (render.yaml lists them).
# Locally, copy this file to backend/.env.

# --- Required ---------------------------------------------------------------------------------
# A MongoDB database just for the Hub (not egertickets' or A-Read's). An existing Atlas cluster is
# fine: use a new database name, e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/isa-tech-hub
MONGODB_URI=mongodb://127.0.0.1:27017/isa-tech-hub
# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Encrypts till credentials and platform webhook secrets in the database. Keep a copy somewhere
# safe: if it's lost or changed, re-enter the till credentials and issue new webhook secrets.
HUB_SECRET_KEY=

# --- Addresses --------------------------------------------------------------------------------
# Public HTTPS address of this API; Safaricom posts payment results here. On Render it defaults to
# the service's own https://….onrender.com address, so set it only for a custom domain.
# PUBLIC_URL=https://hub-api.example.com
# The dashboard's address(es), comma-separated, e.g. https://isa-tech-hub.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# SERVE_CLIENT=true      # serve the built dashboard from this server instead of Vercel
PORT=5100

# --- First dashboard sign-in (created once, on the first start) -------------------------------
# After signing in, change the password under Account and delete BOOTSTRAP_ADMIN_PASSWORD.
# More team accounts: Accounts → Add account in the dashboard, or
#   npm run admin:create -- --email … --name … [--role viewer]
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Isa

# --- The till (created or updated every time the server starts) --------------------------------
# Daraja: developer.safaricom.co.ke → My Apps (consumer key and secret), and the Lipa na M-Pesa
# Online passkey Safaricom emails at go-live. Same values as egertickets:
#   MPESA_SHORTCODE   = the store / head office number that signs requests (egertickets: MPESA_SHORTCODE)
#   MPESA_TILL_NUMBER = the Buy Goods till customers pay (egertickets: MPESA_STORE_NUMBER).
#                       Leave empty for a Paybill.
# Sandbox: MPESA_ENV=sandbox, MPESA_SHORTCODE=174379, no till number, and the passkey shown on the
# Daraja simulator.
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# MPESA_TILL_NAME=ISA main till
#
# More tills: the same names with _2, _3… Each number is its own till ("M-Pesa till 2") with its
# own keys ("M-Pesa consumer key 2"), so they never overlap. MPESA_ENV_2 defaults to MPESA_ENV.
# MPESA_SHORTCODE_2=
# MPESA_TILL_NUMBER_2=
# MPESA_CONSUMER_KEY_2=
# MPESA_CONSUMER_SECRET_2=
# MPESA_PASSKEY_2=
# MPESA_TILL_NAME_2=Partner till

# --- Accounts: merchant sign-up, Google sign-in, email -----------------------------------------
# Businesses can open their own merchant account at <dashboard>/register (SIGNUP=false closes it).
# They see only their own platforms, tills and payments; live payments start once an admin
# approves them under Accounts. A sandbox till works before that.
# SIGNUP=true
# "Sign in with Google": Google Cloud Console → APIs & Services → Credentials → Create credentials
# → OAuth client ID → Web application. Add the dashboard's address (and http://localhost:5173 for
# development) under "Authorised JavaScript origins". Several IDs: comma-separated.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# Email (password resets, email checks, approval news). Any SMTP server; for Gmail, create an app
# password (Google Account → Security → App passwords) and write @ in the address as %40:
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# MAIL_FROM=IsaPay <you@gmail.com>
# Links in emails point at the dashboard: the first CLIENT_ORIGIN unless set.
# APP_URL=https://isa-tech-hub.vercel.app

# --- Optional ---------------------------------------------------------------------------------
# Amount limits for one payment, in KES.
MIN_AMOUNT=1
MAX_AMOUNT=150000
# Background work (status sweep and webhook delivery). Leave on for the main server.
# WORKERS=false
# Render's free plan sleeps after 15 idle minutes; the API pings its own public address to stay
# awake. On by default on Render. Set KEEP_ALIVE=false once you're on the Starter plan.
# KEEP_ALIVE=true
# KEEP_ALIVE_EVERY_MINUTES=10

# --- IsaPay billing (what partner platforms pay you) ------------------------------------------
# Partners on your till pay a percentage; partners on their own till pay a monthly subscription.
# The first BILLING_FREE_AMOUNT of payments each month is free. Your own platforms pay nothing.
# BILLING_PERCENT=1.5
# BILLING_MONTHLY_FEE=1000
# BILLING_FREE_AMOUNT=10000
# BILLING_DUE_DAYS=7
# BILLING_GRACE_DAYS=14
# First month invoiced; by default the month this version first ran.
# BILLING_START_MONTH=2026-11
