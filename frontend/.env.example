# The Hub API's address plus /api. Set this in Vercel (Project → Settings → Environment Variables)
# before building, e.g. https://isa-tech-hub-api.onrender.com/api
# Leave it unset only when the API serves the dashboard itself (SERVE_CLIENT=true).
VITE_API_URL=https://isa-tech-hub-api.onrender.com/api
